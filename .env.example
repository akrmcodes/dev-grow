# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real secrets.

# OpenRouter API key (required)
# Get one at https://openrouter.ai/keys
# Server-only: read in lib/openrouter.ts by /api/chat and /api/score
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Optional model overrides (defaults in lib/openrouter.ts)
# PRIMARY_MODEL=google/gemma-4-31b-it:free
# FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
# ROUTER_MODEL=openrouter/free

# Public app name (optional — shown in client metadata)
NEXT_PUBLIC_APP_NAME=DevGrow
