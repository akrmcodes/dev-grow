# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real secrets.

# OpenRouter API key (required)
# Get one at https://openrouter.ai/keys
# Server-only: read in lib/openrouter.ts by /api/chat and /api/score
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Optional model overrides (defaults in lib/openrouter-models.ts)
# PRIMARY_MODEL=google/gemma-4-31b-it:free
# FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# CODING_FALLBACK_MODEL=cohere/north-mini-code:free
# LAST_RESORT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Or override the full chain (comma-separated):
# FREE_MODEL_CHAIN=google/gemma-4-31b-it:free,cohere/north-mini-code:free

# Public app name (optional — shown in client metadata)
NEXT_PUBLIC_APP_NAME=DevGrow
